// Prisma schema for the Institute Management System

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

model User {
  id                   String    @id @default(cuid())
  name                 String
  email                String    @unique
  passwordHash         String?
  phone                String?
  role                 Role      @default(TEACHER)
  createdAt            DateTime  @default(now())
  studentId            String?   @unique
  student              Student?  @relation(fields: [studentId], references: [id])
  inviteToken          String?   @unique
  inviteTokenExpiresAt DateTime?
  activatedAt          DateTime?

  attendanceRecords AttendanceRecord[]
  gradeRecords      GradeRecord[]
  teacherSubjects   TeacherSubject[]
}

model Student {
  id           String   @id @default(cuid())
  name         String
  grade        String
  studentPhone String?
  parentPhone  String
  enrollDate   DateTime @default(now())
  active       Boolean  @default(true)
  totalFee     Float    @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  payments          Payment[]
  attendanceRecords AttendanceRecord[]
  gradeRecords      GradeRecord[]
  subjects          StudentSubject[]
  loginAccount      User?

  @@index([grade])
}

model Subject {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  teachers          TeacherSubject[]
  enrollments       StudentSubject[]
  attendanceRecords AttendanceRecord[]
  gradeRecords      GradeRecord[]
}

model TeacherSubject {
  id        String   @id @default(cuid())
  teacherId String
  teacher   User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([teacherId, subjectId])
  @@index([subjectId])
}

model StudentSubject {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([studentId, subjectId])
  @@index([subjectId])
}

model Payment {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  amount    Float
  date      DateTime @default(now())
  method    String   @default("cash")
  note      String?
  createdAt DateTime @default(now())

  @@index([studentId])
}

model AttendanceRecord {
  id           String            @id @default(cuid())
  studentId    String
  student      Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date         DateTime
  subjectId    String
  subject      Subject           @relation(fields: [subjectId], references: [id])
  status       AttendanceStatus
  recordedById String?
  recordedBy   User?             @relation(fields: [recordedById], references: [id])
  createdAt    DateTime          @default(now())

  @@unique([studentId, date, subjectId])
  @@index([studentId])
  @@index([date])
}

model GradeRecord {
  id           String   @id @default(cuid())
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId    String
  subject      Subject  @relation(fields: [subjectId], references: [id])
  examName     String
  score        Float
  maxScore     Float    @default(100)
  date         DateTime @default(now())
  recordedById String?
  recordedBy   User?    @relation(fields: [recordedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([studentId])
  @@index([subjectId])
}
